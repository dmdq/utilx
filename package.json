{
  "name": "utilx",
  "version": "1.1.0",
  "description": "有条工具 - 开发者效率工具箱",
  "author": "util.cn",
  "private": true,
  "scripts": {
    "dev": "CHOKIDAR_USEPOLLING=true CHOKIDAR_INTERVAL=1500 CI=1 nuxt dev --host",
    "dev:plain": "CI=1 nuxt dev --host",
    "dev:fast": "./scripts/dev-fast.sh",
    "dev:ultra": "./scripts/dev-ultra-fast.sh",
    "dev:watch": "WATCH=true CI=1 nuxt dev --host",
    "dev:blog": "concurrently \"CI=1 nuxt dev --host\" \"npm run blog:watch\"",
    "optimize": "./scripts/optimize-cache.sh",
    "upgrade:nuxt": "./scripts/upgrade-nuxt.sh",
    "build": "npm run build:blog && npm run build:nuxt",
    "build:static": "npm run build:blog && npm run generate",
    "build:nuxt": "NODE_OPTIONS='--max-old-space-size=8192 --max-semi-space-size=1024' CI=1 nuxt build",
    "build:app": "./scripts/build.sh",
    "build:optimized": "./scripts/build-optimized.sh",
    "build:simple": "./scripts/build-simple.sh",
    "build:blog": "npm run blog:build",
    "blog:build": "cd blog && rm -rf public && hugo --minify && rm -rf ../public/blog && mkdir -p ../public/blog && cp -r public/* ../public/blog/",
    "blog:watch": "cd blog && hugo server --destination ../public/blog/ --watch --buildDrafts --buildFuture",
    "blog:new": "cd blog && hugo new content/posts",
    "generate": "NODE_OPTIONS='--max-old-space-size=8192 --max-semi-space-size=1024' CI=1 nuxt generate",
    "sitemap": "node scripts/generate-sitemap.js && node scripts/generate-llms-txt.js && node scripts/generate-tool-tutorials.js && node scripts/check-blog-coverage.js",
    "llms": "node scripts/generate-llms-txt.js",
    "tutorials": "node scripts/generate-tool-tutorials.js",
    "coverage": "node scripts/check-blog-coverage.js",
    "tauri": "tauri",
    "tauri:dev": "./scripts/dev.sh npm run tauri dev --no-build-frontend",
    "tauri:static": "npm run tauri dev",
    "tauri:build": "tauri build",
    "package:static": "./package-static.sh",
    "package:macos": "./scripts/package-macos.sh",
    "package:macos-universal": "./scripts/package-macos-universal.sh",
    "package:macos-simple": "./scripts/package-macos-simple.sh"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@esotericsoftware/spine-player": "^4.2.96",
    "@esotericsoftware/spine-webgl": "^4.2.96",
    "@tauri-apps/api": "2.9.1",
    "@tauri-apps/plugin-shell": "2.3.3",
    "@tauri-apps/plugin-window-state": "2.4.1",
    "@vueuse/integrations": "^14.1.0",
    "crypto-js": "^4.2.0",
    "exifreader": "^4.48.0",
    "gifenc": "^1.0.3",
    "jsencrypt": "^3.5.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.19.0",
    "lucide-vue-next": "^0.556.0",
    "marked": "^17.0.1",
    "node-forge": "^1.4.0",
    "nuxt": "4.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.6",
    "vue": "3.5.43",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@tauri-apps/cli": "^2.9.6",
    "@types/qrcode": "^1.5.6",
    "@vite-pwa/nuxt": "^1.1.0",
    "concurrently": "^9.2.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "3.4.18"
  }
}
